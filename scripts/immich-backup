#!/bin/bash
set -euo pipefail

BACKUP_ROOT="/mnt/backup/Backup/Immich"
DATABASE_DIR="$BACKUP_ROOT/database"
LIBRARY_DIR="$BACKUP_ROOT/library"

TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
DATABASE_BACKUP="$DATABASE_DIR/immich-$TIMESTAMP.sql.gz"
DATABASE_TMP="$DATABASE_BACKUP.tmp"

mkdir -p "$DATABASE_DIR" "$LIBRARY_DIR"

cleanup() {
    rm -f -- "$DATABASE_TMP"
}

trap cleanup EXIT

echo "[$(date)] Starting Immich database backup..."

docker exec immich_postgres \
    pg_dump --clean --if-exists \
    -U postgres \
    -d immich \
    | gzip > "$DATABASE_TMP"

gzip -t "$DATABASE_TMP"

mv "$DATABASE_TMP" "$DATABASE_BACKUP"

echo "[$(date)] Database backup complete: $DATABASE_BACKUP"

echo "[$(date)] Synchronizing Immich filesystem..."

rsync -aHAX --delete \
    /mnt/myraid/Immich/ \
    "$LIBRARY_DIR/"

echo "[$(date)] Filesystem backup complete."

echo "[$(date)] Removing database backups older than 7 days..."

find "$DATABASE_DIR" \
    -type f \
    -name 'immich-*.sql.gz' \
    -mtime +7 \
    -delete

echo "[$(date)] Immich backup completed successfully."
