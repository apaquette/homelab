#!/bin/bash
set -euo pipefail

STATE_DIR="/var/lib/homelab/container-health"
NTFY_URL="https://ntfy.alexpaquette.dev/homelab-system"
NTFY_TOKEN_FILE="/etc/smartd-ntfy-token"

RESTART_THRESHOLD=3

mkdir -p "$STATE_DIR"

notify() {
    local container="$1"
    local restarts="$2"

    local token
    token=$(cat "$NTFY_TOKEN_FILE")

    curl -fsS \
        --max-time 15 \
        -H "Authorization: Bearer $token" \
        -H "Title: Container restart alert — ${container}" \
        -H "Priority: high" \
        -H "Tags: warning,whale" \
        -d "Container ${container} restarted ${restarts} times during the monitoring interval." \
        -o /dev/null \
        "$NTFY_URL"
}

while IFS= read -r container; do
    [[ -n "$container" ]] || continue

    restart_count="$(
        docker inspect \
            --format '{{.RestartCount}}' \
            "$container"
    )"

    state_file="$STATE_DIR/${container}.count"

    if [[ -f "$state_file" ]]; then
        previous_count=$(cat "$state_file")
    else
        previous_count="$restart_count"
    fi

    delta=$((restart_count - previous_count))

    if (( delta >= RESTART_THRESHOLD )); then
        notify "$container" "$delta"
    fi

    printf '%s\n' "$restart_count" > "$state_file"
done < <(
    docker ps --format '{{.Names}}'
)
