#!/bin/bash

NTFY_URL="https://ntfy.alexpaquette.dev/homelab-smart"
NTFY_TOKEN_FILE="/etc/smartd-ntfy-token"

MESSAGE="$SMARTD_MESSAGE"
DEVICE="$SMARTD_DEVICE"
TYPE="$SMARTD_DEVICESTRING"

if [ -z "$MESSAGE" ]; then
    MESSAGE="SMART notification for ${DEVICE}"
fi

TOKEN=$(cat "$NTFY_TOKEN_FILE")

curl -fsS \
    --max-time 15 \
    -H "Authorization: Bearer $TOKEN" \
    -H "Title: SMART Alert — ${DEVICE}" \
    -H "Priority: high" \
    -H "Tags: warning,computer" \
    -d "$MESSAGE" \
    -o /dev/null \
    "$NTFY_URL"
